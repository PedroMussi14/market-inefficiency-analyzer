# =============================================================================
# Market Inefficiency Analyzer: environment configuration
# Copy this file to `.env` and fill in the providers you want to use.
# Every provider is optional; providers without a key are hidden in the UI.
# =============================================================================

# The Odds API (https://the-odds-api.com): global sportsbook coverage
API_KEY=

# OpticOdds (https://opticodds.com): 350+ books (adapter planned)
OPTICODDS_KEY=

# BrOdds: self-hosted scraper service in ./brodds-api
# BRODDS_LOCAL_KEY must match BRODDS_API_KEY in brodds-api/.env
BRODDS_LOCAL_URL=http://localhost:8000
BRODDS_LOCAL_KEY=
